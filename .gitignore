# Godot's import cache and per-project scratch. Regenerated on first run.
.godot/
*.import

# Editor scratch
.cursor/

# Python's own scratch, written beside tools/fbx_texture_map.py when another
# script imports it as a module.
__pycache__/

# The third-party asset packs themselves. 111 MB of CC0 models across eight
# KayKit packs, fetched rather than committed: ./tools/fetch_kaykit.sh pulls
# exactly these files from itch.io with no account and no sign-in, so carrying
# them in every clone forever buys nothing. The project's own files under
# assets/ -- the per-tag wrapper scenes in assets/tag_scenes/ and the example
# model -- are committed, because those are the part the table points at that
# nobody else can reproduce. README, "Where the art comes from".
/assets/kaykit_*/

# The user's own purchased archives, and what gets unpacked out of them. These
# are not fetchable by any script -- they are files the user bought and dropped
# into assets/ -- so they stay exactly where they were put and out of git, which
# is neither a place to store 294 MB of binaries nor a place to redistribute
# paid art. tools/extract_justcreate.sh, tools/extract_mistage.sh and
# tools/extract_armoury.sh unpack the six this project draws from, reproducibly,
# from the archives beside them, and tools/bake_mistage.sh writes
# assets/mistage_baked/ out of two of them -- which is derived from the same paid
# art and just as reproducible.
/assets/*.rar
/assets/*.zip
/assets/justcreate_village/
/assets/mistage_village/
/assets/mistage_market/
/assets/mistage_battle/
/assets/mistage_forge/
/assets/mistage_alchemy/
/assets/mistage_baked/

# The Sprout Lands UI pack, and what tools/extract_sprout_lands.sh unpacks out of
# it. Same rule as the three above and one reason more: this pack's licence is
# stricter than paid art's usual terms -- "You can not redistribute or resale,
# even if modified" -- so neither the zip nor the unpacked copy nor any file
# derived from one may be committed here, and there is deliberately no fetch
# script for it the way there is for the CC0 KayKit packs. README, "Where the art
# comes from".
/assets/sprout_lands_ui/

# Windows "downloaded from the internet" marks, written by WSL next to every
# file the user copied across. Not ours and not content.
*:Zone.Identifier

# Where ./run_tests.sh keeps the transcript and stall flag of a run in progress,
# beside the checkout rather than in the launching shell's $TMPDIR, so that a
# run outliving the sandbox that started it still has the files its closing
# checks read. The runner's own EXIT trap removes them when a run ends.
.testruns/

# --- Adopted from mythosunwritten (commit f3203d96, see ADOPTION.md) ---
# Its reproducible run artifacts: bulk deterministic village screenshots,
# review reports, and September manual-review render sequences. Small
# regression pins and review contracts stay versioned, exactly as its own
# ignore file kept them.
tests/artifacts/village_review_runs/
/.artifacts/
/artifacts/
/renders/
/docs/qa/2026-09-06-terrain/*.png
/docs/qa/2026-09-07-manual/**/*.png
/docs/qa/2026-09-07-manual/*.png
/docs/qa/2026-09-07-manual/**/*.gif
/docs/qa/2026-09-07-manual/*.gif
/docs/qa/2026-09-07-manual/**/*.log
/docs/qa/2026-09-07-manual/*.log
/docs/qa/2026-09-08-manual/**/*.png
/docs/qa/2026-09-08-manual/*.png
/docs/qa/2026-09-08-manual/**/*.gif
/docs/qa/2026-09-08-manual/*.gif
/docs/qa/2026-09-08-manual/**/*.log
/docs/qa/2026-09-08-manual/*.log

# The source repo also ignored addons/ (its GUT test framework was a local,
# uncommitted install). Kept ignored here until the suite-certification item
# decides how the adopted GUT suite is run from this repo.
/addons/

# The source repo ignored *.uid; this repo commits them (the sidecars Godot
# 4.7 generates for the adopted scripts are committed so their ids are stable
# from here on). Its blanket assets/ ignore is NOT adopted: this repo's
# assets/ tracking is fine-grained, see the rules above.

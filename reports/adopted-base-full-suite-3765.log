    place  kind=one of chest/crate/door/stone at=(<x>, <z>) -- a new thing stands there, on ground that carries it
    remove target=#<id>                   -- a thing is taken out of the world
    spawn  role=one of guard/herald/scout/scholar at=(<x>, <z>) -- a character is rolled for that ground and stands there
